# Codex exec rules for this repository.
# Rules are evaluated from most restrictive to least restrictive.

prefix_rule(
    pattern = ["rm"],
    decision = "prompt",
    justification = "File deletion requires approval in this repository.",
    match = ["rm file.txt", "rm -r docs/tmp"],
)

prefix_rule(
    pattern = ["unlink"],
    decision = "prompt",
    justification = "File deletion requires approval in this repository.",
    match = ["unlink file.txt"],
)

prefix_rule(
    pattern = ["rmdir"],
    decision = "prompt",
    justification = "Directory deletion requires approval in this repository.",
    match = ["rmdir old_dir"],
)

prefix_rule(
    pattern = ["git", "rm"],
    decision = "prompt",
    justification = "Tracked file deletion requires approval in this repository.",
    match = ["git rm old_file.py"],
)

prefix_rule(
    pattern = ["git", "checkout"],
    decision = "prompt",
    justification = "Changing branches requires approval in this repository.",
    match = ["git checkout main"],
)

prefix_rule(
    pattern = ["git", "switch"],
    decision = "prompt",
    justification = "Changing branches requires approval in this repository.",
    match = ["git switch feature-x"],
)

prefix_rule(
    pattern = ["gh", "pr", "checkout"],
    decision = "prompt",
    justification = "Checking out a PR changes branches and requires approval.",
    match = ["gh pr checkout 12"],
)

prefix_rule(
    pattern = ["git", "reset"],
    decision = "forbidden",
    justification = "Do not rewrite history with git reset.",
    match = ["git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Do not delete untracked files with git clean.",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "forbidden",
    justification = "Do not rewrite branch history with git rebase in this repository.",
    match = ["git rebase main"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force push is forbidden in this repository.",
    match = ["git push --force origin main"],
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force push is forbidden in this repository.",
    match = ["git push -f origin main"],
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Repository deletion is forbidden.",
    match = ["gh repo delete owner/repo"],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "PR merge is treated as a destructive remote action in this repository.",
    match = ["gh pr merge 12 --squash"],
)

prefix_rule(
    pattern = ["gh", "pr", "close"],
    decision = "forbidden",
    justification = "PR close is treated as a destructive remote action in this repository.",
    match = ["gh pr close 12"],
)

prefix_rule(
    pattern = ["gh", "issue", "close"],
    decision = "forbidden",
    justification = "Issue close is treated as a destructive remote action in this repository.",
    match = ["gh issue close 34"],
)

prefix_rule(
    pattern = ["ls"],
    decision = "allow",
    justification = "Read-only inspection is allowed.",
    match = ["ls", "ls -la"],
)

prefix_rule(
    pattern = ["pwd"],
    decision = "allow",
    justification = "Read-only inspection is allowed.",
    match = ["pwd"],
)

prefix_rule(
    pattern = ["stat"],
    decision = "allow",
    justification = "Read-only inspection is allowed.",
    match = ["stat AGENTS.md"],
)

prefix_rule(
    pattern = ["find"],
    decision = "allow",
    justification = "Read-only inspection is allowed.",
    match = ["find docs -maxdepth 2 -type f"],
)

prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "Read-only code search is allowed.",
    match = ["rg milestone docs"],
)

prefix_rule(
    pattern = ["sed"],
    decision = "allow",
    justification = "Read-only file inspection is allowed.",
    match = ["sed -n 1,40p AGENTS.md"],
)

prefix_rule(
    pattern = ["cat"],
    decision = "allow",
    justification = "Read-only file inspection is allowed.",
    match = ["cat README.md"],
)

prefix_rule(
    pattern = ["mkdir"],
    decision = "allow",
    justification = "Directory creation is allowed.",
    match = ["mkdir -p docs/memo"],
)

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Git status inspection is allowed.",
    match = ["git status --short"],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Git diff inspection is allowed.",
    match = ["git diff --stat"],
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Git log inspection is allowed.",
    match = ["git log --oneline -5"],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Staging changes is allowed.",
    match = ["git add AGENTS.md"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Creating commits is allowed.",
    match = ["git commit -m chore:update-docs"],
)





prefix_rule(
    pattern = ["gh", "auth", "status"],
    decision = "allow",
    justification = "Authentication status checks are allowed.",
    match = ["gh auth status"],
)

prefix_rule(
    pattern = ["gh", "repo", "view"],
    decision = "allow",
    justification = "Repository inspection is allowed.",
    match = ["gh repo view"],
)

prefix_rule(
    pattern = ["gh", "pr", "status"],
    decision = "allow",
    justification = "PR status inspection is allowed.",
    match = ["gh pr status"],
)

prefix_rule(
    pattern = ["gh", "pr", "view"],
    decision = "allow",
    justification = "PR inspection is allowed.",
    match = ["gh pr view 12"],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "allow",
    justification = "Creating PRs is allowed.",
    match = ["gh pr create --fill"],
)

prefix_rule(
    pattern = ["gh", "issue", "view"],
    decision = "allow",
    justification = "Issue inspection is allowed.",
    match = ["gh issue view 34"],
)

prefix_rule(
    pattern = ["python", "-m", "pytest"],
    decision = "allow",
    justification = "Local test execution is allowed.",
    match = ["python -m pytest"],
)

prefix_rule(
    pattern = ["python", "-m", "compileall"],
    decision = "allow",
    justification = "Lightweight syntax checks are allowed.",
    match = ["python -m compileall src"],
)
